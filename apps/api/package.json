{
  "name": "@edu-restart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "render-build": "pnpm install --frozen-lockfile && pnpm --filter @edu-restart/api exec prisma generate",
    "render-start": "pnpm --filter @edu-restart/api exec prisma migrate deploy && pnpm --filter @edu-restart/api run start"
  },
  "dependencies": {
    "@edu-restart/core": "workspace:*",
    "@edu-restart/schemas": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.2",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
